{
  "name": "www",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "pnpm": "^11.0.0"
  },
  "packageManager": "pnpm@11.1.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lefthook",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "astro dev --port 3000",
    "start": "astro preview --port 3000",
    "build": "astro build",
    "preview": "astro preview --port 3000",
    "typecheck": "astro check",
    "lint": "eslint . --max-warnings=0 --cache",
    "lint:fix": "eslint . --fix",
    "spell": "cspell \"**/*.{ts,tsx,js,jsx,astro,md,json,yml,yaml}\"",
    "format": "prettier . --check --cache",
    "format:fix": "prettier . --write --cache --list-different",
    "commitlint": "commitlint --edit",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:playwright": "playwright test --reporter=list",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/react": "5.0.7",
    "@astrojs/sitemap": "3.7.3",
    "@astrojs/vercel": "^11.0.8",
    "@fontsource/bricolage-grotesque": "5.2.10",
    "@fortawesome/fontawesome-svg-core": "7.3.0",
    "@fortawesome/free-brands-svg-icons": "7.3.0",
    "@tailwindcss/vite": "4.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "animejs": "4.5.0",
    "astro": "6.4.4",
    "astro-navbar": "2.4.0",
    "clsx": "2.1.1",
    "dotenv": "^17.4.2",
    "firebase-admin": "^14.3.0",
    "jiti": "2.7.0",
    "lefthook": "2.1.6",
    "marked": "^18.0.11",
    "razorpay": "^2.9.8",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.3",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.2",
    "turbo": "2.10.4",
    "typescript": "6.0.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@commitlint/cli": "21.0.0",
    "@commitlint/config-conventional": "21.0.0",
    "@cspell/dict-bash": "4.2.2",
    "@cspell/dict-css": "4.1.1",
    "@cspell/dict-es-es": "3.0.8",
    "@cspell/dict-html": "4.0.15",
