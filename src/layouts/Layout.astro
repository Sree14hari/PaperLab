---
interface Props {
  title: string
  description?: string
  ogImage?: string
  isHome?: boolean
  redirect?: string
}

const { title, description, ogImage, isHome, redirect } = Astro.props
const defaultDescription =
  'Paper Lab is a modern academic report editor built for students and researchers. Features a full LaTeX engine, priority cloud compiles, and a WYSIWYG diagram editor.'
import '@fontsource/bricolage-grotesque/400.css'
import '@fontsource/bricolage-grotesque/500.css'
import '@fontsource/bricolage-grotesque/600.css'
import '../styles/global.css'
import Footer from '~/components/Footer.astro'
import NavBar from '~/components/NavBar.astro'
import { getLocale } from '~/utils/i18n'
const locale = getLocale(Astro)
---

<script is:inline data-cfasync="false">
  const theme = (() => {
    if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
      return localStorage.getItem('theme') ?? 'light'
    }
    if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      return 'dark'
    }
    return 'light'
  })()

  if (theme === 'light') {
    document.documentElement.setAttribute('data-theme', 'light')
  } else {
    document.documentElement.setAttribute('data-theme', 'dark')
  }
</script>

<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    {redirect ? <meta http-equiv="refresh" content={`0;url=${redirect}`} /> : null}
    <meta name="description" content={description ?? defaultDescription} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="sitemap" href="/sitemap-0.xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site || 'https://paperlab.r3actr.work')} />
    <meta name="robots" content="index, follow" />
    <meta name="keywords" content="LaTeX editor, academic report, WYSIWYG diagram, student tools, research writing, cloud compile, paper lab" />

    {
      isHome && (
        <>
          {/* Injecting schema to homepage only (for SEO) */}
          <script
            is:inline
            type="application/ld+json"
            set:html={JSON.stringify({
              '@context': 'https://schema.org',
              '@type': 'WebSite',
              name: 'Paper Lab',
              url: 'https://paperlab.r3actr.work',
            })}
          />
        </>
      )
    }

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="theme-color" content="#da755b" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="Paper Lab" />
    <meta property="og:locale" content={locale} />
    <meta property="og:image" content={ogImage ?? new URL('/previewpplab.png', Astro.site || 'https://paperlab.r3actr.work').href} />
    <meta property="og:image:alt" content="Paper Lab - Modern Academic Report Editor" />
    <meta property="og:description" content={description ?? defaultDescription} />
    <meta property="og:color" content="#da755b" />
    <!-- Twitter card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@paperlab" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description ?? defaultDescription} />
    <meta name="twitter:image" content={ogImage ?? new URL('/previewpplab.png', Astro.site || 'https://paperlab.r3actr.work').href} />
    <meta name="twitter:image:alt" content="Paper Lab - Modern Academic Report Editor" />
    <!-- RSS Feed -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Paper Lab Release Notes"
      href={`${Astro.url.origin}/feed.xml`}
    />

    <script>
      // eslint-disable-next-line no-console
      console.log(
        '%c📝 Paper Lab%c\nWelcome to a better research workflow!',
        'filter: invert(1); font-size: 28px; font-weight: bolder; font-family: "Rubik"; margin-top: 20px; margin-bottom: 8px;',
        'color: #ea580c; font-size: 16px; font-family: "Rubik"; margin-bottom: 20px;'
      )
    </script>
  </head>
  <body
    class="bg-paper text-dark min-h-[max(100dvh,_64rem)] overflow-x-hidden font-['bricolage-grotesque'] text-balance"
  >
    <NavBar />
    <slot />
    <Footer />
  </body>
</html>
