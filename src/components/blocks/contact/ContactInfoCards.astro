---
// Contact Info Cards
// ------------
// Description: A contact info cards section with a title
// Properties:
// - title: The title of the contact info cards section

// Components
// - Layout
import Section from '../../ui/Section.astro'
import Row from '../../ui/Row.astro'
import Col from '../../ui/Col.astro'
// - UI
import ActionCard from '../../ui/cards/ActionCard.astro'
import DecorationBorder from '../../ui/DecorationBorder.astro'

// Content
// - Props
type Props = {
	title?: string
}
const { title = '' } = Astro.props
---

<Section>
	<Row decorationBorder="top left " gapY="0" style="transparent">
		<Col
			span="12"
			classes="px-8 py-12 relative bg-[url('/bgs/dot-gray-light.svg')] bg-size-[18px] bg-fixed dark:bg-[url('/bgs/dot-gray-dark.svg')] dark:bg-size-[18px] dark:bg-fixed "
		>
			<h2 class="h5 mb-0! text-center leading-0">{title}</h2>
			<DecorationBorder type="bottom" style="dashed" />
		</Col>
	</Row>
</Section>
<Section>
	<Row decorationBorder="top left right bottom" gapY="0" style="transparent">
		<Col span="4" style="transparent">
			<ActionCard title="Technical Support" link="https://discord.gg/gnjkkGT5RS" linkText="Contact Support">
				<p>
					Need help with LaTeX compilation, citation imports, or report formatting? Our technical team is ready to assist you.
				</p>
			</ActionCard>
		</Col>
		<Col span="4" style="transparent">
			<ActionCard title="Academic & Sales" link="mailto:r3actr@gmail.com?subject=Paper%20Lab%20Academic%20%26%20Sales" linkText="Connect with Sales">
				<p>
					Interested in group lab licenses, university department plans, or enterprise subscriptions? Speak with our academic team.
				</p>
			</ActionCard>
		</Col>
		<Col span="4" style="transparent">
			<ActionCard title="Feature Requests" link="https://discord.gg/gnjkkGT5RS" linkText="Send Feedback">
				<p>
					Have an idea for a new LaTeX template, citation style, or vector diagram tool? We'd love to hear your feedback and feature requests.
				</p>
			</ActionCard>
		</Col>
	</Row>
</Section>
