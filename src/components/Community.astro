---
import Video from '~/components/Video.astro'
import { getLocale, getUI } from '~/utils/i18n'

const locale = getLocale(Astro)

const {
  routes: {
    index: { community },
  },
} = getUI(locale)
---

<section
  id="community"
  class="relative flex w-full flex-col items-center gap-6 py-12 text-start md:text-center lg:py-36"
>
  <h2 class="mb-2 text-4xl font-bold sm:text-6xl">
    {community.title}
  </h2>
  <p class="text-base lg:w-1/2 lg:px-0">
    <span class="opacity-80">{community.description}</span>
  </p>
  <div class="community__button flex w-full justify-center"></div>
  <div class="flex max-w-full justify-center lg:max-w-none">
    <Video
      name="citation"
      autoplay
      loop
      muted
      playsinline
      preload="none"
      class="max-w-full rounded-3xl shadow-md lg:mx-auto dark:opacity-90"
    />
  </div>
</section>
