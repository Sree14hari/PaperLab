---
// Pricing Card
import Button from './Button.astro'

type Prices = {
  annually?: number | null
  monthly?: number | null
}
type CTA = {
  label: string
  href: string
}
type PricesNotes = {
  annually?: string | null
  monthly?: string | null
}

interface Props {
  id: string
  title: string
  tagline?: string
  prices?: Prices
  pricesNotes?: PricesNotes
  tag?: string
  featured?: boolean
  features: string[]
  cta?: CTA
  classes?: string
}

const {
  id,
  title,
  tagline = '',
  prices,
  pricesNotes,
  tag,
  featured = false,
  features = [],
  cta,
  classes = ''
} = Astro.props
---

<div class:list={["flex flex-col h-full rounded-2xl border transition-shadow duration-300", featured ? "border-coral shadow-lg bg-paper" : "border-dark/10 bg-subtle", classes]}>
  <div class="p-8 pb-0">
    <div class="flex items-center justify-between mb-4">
      <h3 class="text-2xl font-bold font-headings text-dark">
        {title}
      </h3>
      {tag && (
        <span class="inline-flex items-center rounded-full bg-coral/10 px-3 py-1 text-sm font-medium text-coral">
          {tag}
        </span>
      )}
    </div>
    {tagline && <p class="text-sm opacity-70 mb-6">{tagline}</p>}
    
    {prices && (
      <div class="flex items-baseline gap-2 mb-8 border-b border-dark/10 pb-8">
        <span class="text-5xl font-bold font-headings text-dark" data-price-monthly={prices.monthly} data-price-annually={prices.annually}>
          ${prices.monthly ?? prices.annually}
        </span>
        {pricesNotes && (
          <span class="text-sm opacity-60 font-medium" data-price-monthly-note={pricesNotes.monthly} data-price-annually-note={pricesNotes.annually}>
            {pricesNotes.monthly ?? pricesNotes.annually}
          </span>
        )}
      </div>
    )}
  </div>

  <div class="p-8 pt-0 flex-1 flex flex-col">
    {features.length > 0 && (
      <ul class="flex-1 space-y-4 mb-8">
        {features.map((f) => (
          <li class="flex items-start gap-3">
            <svg class="h-6 w-6 shrink-0 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
            </svg>
            <span class="text-sm opacity-80">{f}</span>
          </li>
        ))}
      </ul>
    )}

    {cta && !featured && (
      <Button href={cta.href} class="w-full text-center py-4 bg-dark/5 hover:bg-dark/10 text-dark font-semibold rounded-xl border border-dark/10 transition-colors">
        {cta.label}
      </Button>
    )}
    
    {cta && featured && (
      <div class="razorpay-trigger w-full" data-plan={id} data-amount={prices?.annually ? prices.annually * 100 : 0} data-key={import.meta.env.PUBLIC_RAZORPAY_KEY_ID}>
        <button class="w-full text-center py-4 bg-coral hover:bg-coral-dark text-paper font-semibold rounded-xl transition-colors shadow-md hover:shadow-lg cursor-pointer">
          {cta.label}
        </button>
      </div>
    )}
  </div>
</div>

<script is:inline src="https://checkout.razorpay.com/v1/checkout.js"></script>
<script is:inline>
  if (typeof window !== 'undefined') {
    const initRazorpay = () => {
      const showError = (title, message) => {
        let errModal = document.getElementById('custom-error-modal');
        if (!errModal) {
          errModal = document.createElement('dialog');
          errModal.id = 'custom-error-modal';
          errModal.className = "p-0 bg-transparent backdrop:bg-black/50 backdrop:backdrop-blur-sm rounded-2xl w-[90%] max-w-sm m-auto fixed inset-0 z-[60] transition-opacity";
          errModal.innerHTML = `
            <div class="bg-paper border border-dark/10 rounded-2xl p-6 shadow-xl relative overflow-hidden text-center">
              <div class="relative z-10">
                <div class="mx-auto flex items-center justify-center h-12 w-12 rounded-full bg-red-100 mb-4">
                  <svg class="h-6 w-6 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                  </svg>
                </div>
                <h3 id="error-modal-title" class="text-xl font-bold text-dark mb-2">Error</h3>
                <p id="error-modal-message" class="text-dark/70 mb-6 text-sm"></p>
                <button type="button" id="error-modal-close" class="w-full px-5 py-2.5 rounded-xl font-medium bg-dark/5 hover:bg-dark/10 text-dark transition-colors cursor-pointer">Close</button>
              </div>
            </div>
          `;
          document.body.appendChild(errModal);
          document.getElementById('error-modal-close').addEventListener('click', () => errModal.close());
        }
        document.getElementById('error-modal-title').innerText = title;
        document.getElementById('error-modal-message').innerText = message;
        errModal.showModal();
      };

      const triggers = document.querySelectorAll('.razorpay-trigger');
      triggers.forEach(trigger => {
        const planId = trigger.getAttribute('data-plan');
        if (planId === 'pro') {
          trigger.addEventListener('click', async (e) => {
            e.preventDefault();
            e.stopPropagation();

            const rzpKey = trigger.getAttribute('data-key');
            const amount = 9900; 

            let modal = document.getElementById('custom-email-modal');
            if (!modal) {
              modal = document.createElement('dialog');
              modal.id = 'custom-email-modal';
              modal.className = "p-0 bg-transparent backdrop:bg-black/50 backdrop:backdrop-blur-sm rounded-2xl w-[90%] max-w-md m-auto fixed inset-0 z-50 transition-opacity";
              modal.innerHTML = `
                <div class="bg-paper border border-dark/10 rounded-2xl p-6 shadow-xl relative overflow-hidden">
                  <div class="relative z-10 text-left">
                    <h3 class="text-xl font-bold text-dark mb-2">Upgrade to Premium</h3>
                    <p class="text-dark/70 mb-6 text-sm">Please enter your email address to securely link your payment and activate your premium features.</p>
                    <form id="email-modal-form">
                      <div class="mb-6">
                        <label for="premium-email" class="block text-sm font-medium text-dark/80 mb-2">Email Address</label>
                        <input type="email" id="premium-email" required class="w-full px-4 py-3 rounded-xl border border-dark/20 bg-white text-dark focus:outline-none focus:ring-2 focus:ring-coral transition-shadow" placeholder="you@example.com" />
                      </div>
                      <div class="flex gap-3 justify-end">
                        <button type="button" id="email-modal-cancel" class="px-5 py-2.5 rounded-xl font-medium text-dark/70 hover:bg-dark/5 transition-colors cursor-pointer">Cancel</button>
                        <button type="submit" class="px-5 py-2.5 rounded-xl font-medium bg-coral hover:bg-coral-dark text-paper transition-colors shadow-md hover:shadow-lg cursor-pointer">Continue</button>
                      </div>
                    </form>
                  </div>
                </div>
              `;
              document.body.appendChild(modal);
            }

            const input = document.getElementById('premium-email');
            const form = document.getElementById('email-modal-form');
            const cancelBtn = document.getElementById('email-modal-cancel');
            
            input.value = '';
            modal.showModal();

            const userEmail = await new Promise((resolve) => {
              form.onsubmit = (event) => {
                event.preventDefault();
                resolve(input.value);
                modal.close();
              };
              cancelBtn.onclick = () => {
                resolve(null);
                modal.close();
              };
            });

            if (!userEmail || !userEmail.includes('@')) {
              return;
            }

            try {
              const orderRes = await fetch('/api/create-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ amount, currency: 'INR', email: userEmail })
              });
              const order = await orderRes.json();

              if (order.error) {
                if (order.error.includes("Account not found")) {
                  showError("Account Not Found", "We couldn't find an account with that email. Please download and log into the Paper Lab app first!");
                } else if (order.error.includes("already have Premium access") || order.error.includes("Lifetime Premium")) {
                  showError("Already Premium", order.error);
                } else {
                  showError("Order Failed", order.error);
                }
                return;
              }

              const options = {
                key: rzpKey,
                amount: order.amount,
                currency: order.currency,
                name: "Paper Lab",
                description: "Upgrade to Pro",
                order_id: order.id,
                prefill: {
                  email: userEmail
                },
                handler: async function (response) {
                  try {
                    const verifyRes = await fetch('/api/verify-payment', {
                      method: 'POST',
                      headers: { 'Content-Type': 'application/json' },
                      body: JSON.stringify({
                        razorpay_order_id: response.razorpay_order_id,
                        razorpay_payment_id: response.razorpay_payment_id,
                        razorpay_signature: response.razorpay_signature
                      })
                    });
                    const verifyData = await verifyRes.json();
                    if (verifyData.success) {
                      alert('Payment successful! You are now a Premium user.');
                    } else {
                      showError('Verification Failed', 'Payment verification failed. If you were charged, please contact support.');
                    }
                  } catch (err) {
                    showError('Verification Error', 'Failed to verify payment with our servers.');
                  }
                },
                theme: { color: "#ea580c" }
              };

              const rzp = new window.Razorpay(options);
              rzp.on('payment.failed', function (response) {
                showError("Payment Failed", response.error.description);
              });
              rzp.open();

            } catch (err) {
              console.error(err);
              showError('Checkout Error', 'Failed to initiate checkout. Please try again later.');
            }
          });
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initRazorpay);
    } else {
      initRazorpay();
    }
    
    document.addEventListener('astro:page-load', initRazorpay);
  }
</script>
