---
import { getLocale, getUI } from '~/utils/i18n'

const locale = getLocale(Astro)

const {
  routes: {
    index: { hero },
  },
} = getUI(locale)
---

<section id="collaboration" class="relative flex w-full flex-col py-12 lg:py-32">
  <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-14">
    <!-- Image on Left -->
    <div class="origyn-anim flex justify-center lg:col-span-5">
      <picture class="w-full max-w-sm drop-shadow-md sm:max-w-md lg:max-w-full">
        <source
          media="(max-width: 640px)"
          srcset="/illustrations/Seamless%20Team%20Collaboration%20Workspace-sm.webp"
          type="image/webp"
        />
        <source
          srcset="/illustrations/Seamless%20Team%20Collaboration%20Workspace.webp"
          type="image/webp"
        />
        <img
          src="/illustrations/Seamless%20Team%20Collaboration%20Workspace.png"
          alt="Seamless Team Collaboration Workspace - Paper Lab"
          class="h-auto w-full drop-shadow-md"
          width={1200}
          height={800}
          decoding="async"
          loading="lazy"
        />
      </picture>
    </div>

    <!-- Text on Right -->
    <div class="flex flex-col items-start gap-5 text-start lg:col-span-7">
      <h2 class="origyn-anim text-3xl font-bold text-balance sm:text-5xl lg:text-6xl">
        Seamless Team Collaboration Workspace
      </h2>

      <p
        class="origyn-anim text-dark/80 text-base leading-relaxed text-balance opacity-90 sm:text-lg"
      >
        {hero.origynDesc}
      </p>
    </div>
  </div>
</section>

<script>
  import { animate, onScroll, stagger } from 'animejs'

  function initAnimations() {}
  document.addEventListener('astro:page-load', initAnimations)
</script>
