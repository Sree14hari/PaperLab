---
import { getLocale, getUI } from '~/utils/i18n'

const locale = getLocale(Astro)

const {
  routes: {
    index: { hero },
  },
} = getUI(locale)

const features = [
  {
    title: '6-Model Neural & Statistical Analysis',
    description:
      'Evaluates perplexity, burstiness, and semantic token distributions across 6 distinct models to virtually eliminate false positives.',
    icon: 'models',
  },
  {
    title: 'Line-by-Line Origin Attribution',
    description:
      'Maps text lineage with visual heatmaps to isolate synthesized passages from original scholarly drafting.',
    icon: 'map',
  },
  {
    title: 'Exportable Academic AI Reports',
    description:
      'Generate verifiable confidence audit reports to provide full transparency for peer reviews and journal submissions.',
    icon: 'shield',
  },
]
---

<section id="origyn" class="relative flex w-full flex-col py-12 lg:py-32">
  <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-12 lg:gap-14">
    <!-- Image on Left -->
    <div
      class="origyn-anim flex justify-center lg:col-span-5"
      style="transform: translateY(20px); opacity: 0.001; filter: blur(4px)"
    >
      <img
        src="/Mapping%20the%20Origin%20of%20Text.png"
        alt="Mapping the Origin of Text - ORIGYN AI Content Detection"
        class="border-dark/10 w-full max-w-sm rounded-2xl border shadow-xl sm:max-w-md lg:max-w-full dark:border-white/10"
        width={1200}
        height={800}
        decoding="async"
        loading="lazy"
      />
    </div>

    <!-- Text on Right -->
    <div class="flex flex-col items-start gap-5 text-start lg:col-span-7">
      <div
        class="origyn-anim border-coral/20 bg-coral/10 text-coral inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-semibold tracking-wider uppercase"
        style="transform: translateY(20px); opacity: 0.001; filter: blur(4px)"
      >
        <span>✨</span>
        <span>{hero.origynTitle}</span>
      </div>

      <h2
        class="origyn-anim text-3xl font-bold text-balance sm:text-5xl lg:text-6xl"
        style="transform: translateY(20px); opacity: 0.001; filter: blur(4px)"
      >
        Mapping the Origin of Text
      </h2>

      <p
        class="origyn-anim text-dark/80 text-base leading-relaxed text-balance opacity-90 sm:text-lg"
        style="transform: translateY(20px); opacity: 0.001; filter: blur(4px)"
      >
        {hero.origynDesc}
      </p>

      <div
        class="origyn-anim flex flex-col gap-4 pt-2"
        style="transform: translateY(20px); opacity: 0.001; filter: blur(4px)"
      >
        {
          features.map(item => (
            <div class="flex items-start gap-3.5">
              <div class="border-coral/20 bg-coral/10 mt-0.5 flex size-8 shrink-0 items-center justify-center rounded-lg border">
                {item.icon === 'models' && (
                  <svg
                    class="text-coral size-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <circle cx="6" cy="6" r="2.5" />
                    <circle cx="18" cy="6" r="2.5" />
                    <circle cx="6" cy="18" r="2.5" />
                    <circle cx="18" cy="18" r="2.5" />
                    <line x1="8.5" y1="6" x2="15.5" y2="6" />
                    <line x1="6" y1="8.5" x2="6" y2="15.5" />
                    <line x1="8.5" y1="18" x2="15.5" y2="18" />
                    <line x1="18" y1="8.5" x2="18" y2="15.5" />
                    <line x1="8" y1="8" x2="16" y2="16" stroke-dasharray="1 1" />
                  </svg>
                )}
                {item.icon === 'map' && (
                  <svg
                    class="text-coral size-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
                    />
                  </svg>
                )}
                {item.icon === 'shield' && (
                  <svg
                    class="text-coral size-4"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                    />
                  </svg>
                )}
              </div>
              <div>
                <h4 class="text-sm font-semibold sm:text-base">{item.title}</h4>
                <p class="text-dark/70 text-xs leading-relaxed opacity-80 sm:text-sm">
                  {item.description}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { animate, onScroll, stagger } from 'animejs'

  function initAnimations() {
    const elements = document.querySelectorAll('#origyn .origyn-anim')

    animate(elements, {
      opacity: { from: 0.001, to: 1 },
      translateY: { from: 20, to: 0 },
      filter: { from: 'blur(4px)', to: 'blur(0px)' },
      duration: 600,
      delay: stagger(120),
      ease: 'cubicBezier(0.25, 0.1, 0.25, 1)',
      autoplay: onScroll({
        target: '#origyn',
      }),
    })
  }
  initAnimations()
  document.addEventListener('astro:page-load', initAnimations)
</script>
