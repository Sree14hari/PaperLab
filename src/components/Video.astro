---
type Props = {
  name: string
  class?: string
} & astroHTML.JSX.VideoHTMLAttributes

const { name, class: className, autoplay, ...rest }: Props = Astro.props
---

{/* eslint-disable-next-line jsx-a11y/media-has-caption */}
<video
  class:list={['lazy-video w-fit', className]}
  preload="none"
  poster={`/media/${name}/poster.webp`}
  data-autoplay={autoplay ? 'true' : undefined}
  {...rest}
>
  <source data-src={`/media/${name}/video.webm`} type="video/webm" />
  <source data-src={`/media/${name}/video.mp4`} type="video/mp4" />
</video>

<script>
  const setupLazyVideos = () => {
    const lazyVideos = document.querySelectorAll('video.lazy-video')

    if ('IntersectionObserver' in window) {
      const lazyVideoObserver = new IntersectionObserver(
        (entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              const videoEl = entry.target as HTMLVideoElement

              // Swap data-src to src for all source tags
              const sources = videoEl.querySelectorAll('source')
              sources.forEach(source => {
                if (source.dataset.src) {
                  source.src = source.dataset.src
                }
              })

              videoEl.load()
              if (videoEl.dataset.autoplay === 'true') {
                videoEl.play().catch(e => console.warn('Autoplay prevented:', e))
              }

              lazyVideoObserver.unobserve(videoEl)
              videoEl.classList.remove('lazy-video')
            }
          })
        },
        { rootMargin: '0px 0px 400px 0px' }
      )

      lazyVideos.forEach(lazyVideo => {
        lazyVideoObserver.observe(lazyVideo)
      })
    }
  }

  setupLazyVideos()
  document.addEventListener('astro:page-load', setupLazyVideos)
</script>
