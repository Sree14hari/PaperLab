---
import Title from './Title.astro'

interface Row {
  category: string
  free: string
  pro: string
}

interface Headers {
  category: string
  free: string
  pro: string
}

interface Props {
  id?: string
  title?: string
  subtitle?: string
  description?: string
  headers?: Headers
  rows?: Row[]
}

const defaultHeaders: Headers = {
  category: 'Feature Category',
  free: 'Free Tier',
  pro: 'Pro / Premium',
}

const defaultRows: Row[] = [
  {
    category: 'Projects',
    free: 'Unlimited',
    pro: 'Unlimited',
  },
  {
    category: 'Standard LaTeX Compiling',
    free: 'Free & Unlimited',
    pro: 'Free & Unlimited',
  },
  {
    category: 'IEEE & Journal Compiles',
    free: '10 compiles / month each',
    pro: 'Unlimited',
  },
  {
    category: 'IEEE Word (.docx) Export',
    free: '🔒 Locked',
    pro: 'Unlocked',
  },
  {
    category: 'Desktop Companion Skins',
    free: 'Boba only',
    pro: 'All 6 Skins + Custom Upload',
  },
  {
    category: 'Global Reference Library',
    free: '🔒 Locked',
    pro: 'Unlocked',
  },
  {
    category: 'Live Scholar Search',
    free: '🔒 Locked',
    pro: 'Unlocked',
  },
  {
    category: 'AI Auto-Citation',
    free: '🔒 Locked',
    pro: 'Unlocked',
  },
  {
    category: 'AI Content Detection',
    free: 'Daily limited',
    pro: '5 checks / day',
  },
  {
    category: 'LaTeX Git Integration',
    free: '🔒 Locked',
    pro: 'Unlocked',
  },
]

const {
  id = 'comparison',
  title = 'Feature Comparison',
  subtitle = 'Compare Plans',
  description = 'Compare what is included in Free vs Pro / Premium side by side.',
  headers = defaultHeaders,
  rows = defaultRows,
} = Astro.props

const isLocked = (val: string) => val.includes('Locked') || val.includes('🔒')
const isUnlocked = (val: string) => val.toLowerCase().includes('unlocked')
const cleanValue = (val: string) =>
  val
    .replace(/^\*\*(.*)\*\*$/, '$1')
    .replace('🔒', '')
    .trim()
---

<section id={id} class="mx-auto w-full max-w-5xl scroll-mt-24 pt-16">
  <div class="mb-10 text-center">
    {subtitle && <h2 class="text-coral text-sm font-bold tracking-wider uppercase">{subtitle}</h2>}
    {title && <Title class="mt-2 !text-3xl sm:!text-4xl">{title}</Title>}
    {description && <p class="text-dark/70 mx-auto mt-2 max-w-2xl text-base">{description}</p>}
  </div>

  <div class="border-dark/10 bg-subtle/40 overflow-hidden rounded-3xl border shadow-sm">
    <div class="overflow-x-auto">
      <table class="w-full min-w-[620px] border-collapse text-left">
        <thead>
          <tr class="border-dark/10 bg-subtle/80 border-b">
            <th class="text-dark px-6 py-5 text-sm font-bold tracking-wider uppercase">
              {headers.category}
            </th>
            <th class="text-dark w-[28%] px-6 py-5 text-sm font-bold tracking-wider uppercase">
              {headers.free}
            </th>
            <th
              class="text-coral bg-coral/5 w-[32%] px-6 py-5 text-sm font-bold tracking-wider uppercase"
            >
              <div class="flex items-center gap-2">
                <span>{headers.pro}</span>
                <span
                  class="bg-coral rounded-full px-2 py-0.5 text-[10px] font-bold tracking-normal text-white uppercase"
                >
                  Best Value
                </span>
              </div>
            </th>
          </tr>
        </thead>
        <tbody class="divide-dark/5 divide-y text-sm">
          {
            rows.map((row, idx) => {
              const freeIsLocked = isLocked(row.free)
              const proIsUnlocked = isUnlocked(row.pro)
              const freeClean = cleanValue(row.free)
              const proClean = cleanValue(row.pro)
              const isProHighlighted =
                row.pro.startsWith('**') ||
                proIsUnlocked ||
                row.category === 'IEEE & Journal Compiles' ||
                row.category === 'Desktop Companion Skins' ||
                row.category === 'AI Content Detection'

              return (
                <tr
                  class={
                    idx % 2 === 0
                      ? 'bg-transparent'
                      : 'bg-subtle/20 hover:bg-subtle/40 transition-colors'
                  }
                >
                  <td class="text-dark px-6 py-4.5 font-medium">{row.category}</td>
                  <td class="px-6 py-4.5">
                    {freeIsLocked ? (
                      <span class="bg-dark/5 text-dark/60 inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-medium">
                        <svg
                          class="h-3.5 w-3.5 opacity-60"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
                          <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                        </svg>
                        Locked
                      </span>
                    ) : (
                      <span class="text-dark/80 font-normal">{freeClean}</span>
                    )}
                  </td>
                  <td class="bg-coral/[0.02] px-6 py-4.5">
                    {proIsUnlocked ? (
                      <span class="bg-coral/10 text-coral inline-flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-semibold">
                        <svg
                          class="text-coral h-3.5 w-3.5"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2.5"
                        >
                          <polyline points="20 6 9 17 4 12" />
                        </svg>
                        Unlocked
                      </span>
                    ) : isProHighlighted ? (
                      <span class="text-coral font-bold">{proClean}</span>
                    ) : (
                      <span class="text-dark font-medium">{proClean}</span>
                    )}
                  </td>
                </tr>
              )
            })
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
