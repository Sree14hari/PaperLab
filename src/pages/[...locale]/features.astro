---
import Button from '~/components/Button.astro'
import Description from '~/components/Description.astro'
import Layout from '~/layouts/Layout.astro'
import { getLocale, getUI } from '~/utils/i18n'
export { getStaticPaths } from '~/utils/i18n'

const locale = getLocale(Astro)

const {
  routes: { features },
  layout,
} = getUI(locale)

// Helper to render icon by name
const getIcon = (iconName: string) => {
  switch (iconName) {
    case 'document-text':
      return `<svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`
    case 'code-bracket':
      return `<svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>`
    case 'folder':
      return `<svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"/></svg>`
    case 'arrows-right-left':
      return `<svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4"/></svg>`
    case 'at-symbol':
      return `<svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"/></svg>`
    case 'clipboard-document-check':
      return `<svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/></svg>`
    case 'document-chart-bar':
      return `<svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>`
    case 'arrow-down-tray':
      return `<svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>`
    case 'light-bulb':
      return `<svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>`
    case 'chart-bar':
      return `<svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 8v8m-4-5v5m-4-2v2m-2 4h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>`
    case 'flag':
      return `<svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 21v-4m0 0V5a2 2 0 012-2h6.5l1 1H21l-3 6 3 6h-8.5l-1-1H5a2 2 0 00-2 2zm9-13.5V9"/></svg>`
    case 'server-stack':
      return `<svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/></svg>`
    default:
      return `<svg xmlns="http://www.w3.org/2000/svg" class="size-6 text-coral" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`
  }
}
---

<Layout title={layout.features.title} description={layout.features.description}>
  <main class="container flex min-h-screen w-full flex-col gap-24 py-24">
    <!-- Hero Section -->
    <div class="flex w-full flex-col gap-6 lg:w-3/4">
      <Description class="text-6xl leading-none font-bold lg:text-7xl">
        {features.hero.title}
      </Description>
      <Description class="max-w-4xl text-lg opacity-80 leading-relaxed">
        {features.hero.description}
      </Description>
      <div class="mt-4 flex flex-wrap items-center gap-4">
        <Button
          href={features.cta.buttonLink}
          isPrimary
          class="w-fit"
        >
          {features.cta.buttonText}
        </Button>
        <a
          href="#features-list"
          class="border-subtle bg-subtle/50 hover:border-coral inline-flex items-center gap-2 rounded-2xl border px-6 py-3 text-base font-medium transition-all"
        >
          Explore All Features &darr;
        </a>
      </div>
    </div>

    <!-- Interactive Highlights Ribbon -->
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
      <div class="border-subtle bg-subtle/50 hover:border-coral group flex flex-col gap-4 rounded-2xl border p-6 transition-all duration-200">
        <div class="text-coral text-4xl font-bold">01</div>
        <div class="flex flex-col gap-1">
          <h3 class="text-xl font-bold">Dual-Mode Editing</h3>
          <p class="text-sm opacity-75">Switch seamlessly between visual WYSIWYG writing and raw Monaco LaTeX source code.</p>
        </div>
      </div>
      <div class="border-subtle bg-subtle/50 hover:border-coral group flex flex-col gap-4 rounded-2xl border p-6 transition-all duration-200">
        <div class="text-coral text-4xl font-bold">02</div>
        <div class="flex flex-col gap-1">
          <h3 class="text-xl font-bold">Global Citations</h3>
          <p class="text-sm opacity-75">Universal BibTeX library with instant search, auto-formatting, and DOI import.</p>
        </div>
      </div>
      <div class="border-subtle bg-subtle/50 hover:border-coral group flex flex-col gap-4 rounded-2xl border p-6 transition-all duration-200">
        <div class="text-coral text-4xl font-bold">03</div>
        <div class="flex flex-col gap-1">
          <h3 class="text-xl font-bold">Publication Exports</h3>
          <p class="text-sm opacity-75">Generate journal-ready PDFs, vector graphics, and packaged LaTeX source archives.</p>
        </div>
      </div>
    </div>

    <!-- Feature Categories & Cards Grid -->
    <div id="features-list" class="flex w-full flex-col gap-24 scroll-mt-24">
      {
        features.sections.map((section: any) => (
          <div class="flex flex-col gap-6">
            <!-- Section Header -->
            <div class="flex flex-col gap-2">
              <span class="text-coral text-sm font-semibold uppercase tracking-widest">
                {section.subtitle}
              </span>
              <div class="text-4xl leading-none font-bold lg:text-5xl">
                {section.title}
              </div>
            </div>

            <!-- Cards Grid -->
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4 mt-2">
              {section.features.map((feature: any) => (
                <div class="border-subtle bg-subtle/50 hover:border-coral group relative flex flex-col justify-between gap-4 rounded-2xl border p-6 transition-all duration-200">
                  <div class="flex flex-col gap-4">
                    <div class="text-coral flex h-8 w-8 shrink-0 items-center justify-start transition-transform duration-300 group-hover:scale-110 [&>svg]:h-8 [&>svg]:w-8">
                      <Fragment set:html={getIcon(feature.icon)} />
                    </div>
                    <div class="flex flex-col gap-2">
                      <h3 class="text-xl font-bold leading-tight">
                        {feature.title}
                      </h3>
                      <p class="text-sm opacity-75 leading-relaxed">
                        {feature.description}
                      </p>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))
      }
    </div>

    <!-- CTA Section -->
    <div class="border-subtle bg-subtle/30 relative flex w-full flex-col items-center justify-center gap-8 overflow-hidden rounded-3xl border px-6 py-20 text-center lg:py-32">
      <div class="relative z-10 flex max-w-3xl flex-col items-center gap-6">
        <div class="text-4xl font-extrabold tracking-tight lg:text-6xl">
          {features.cta.title}
        </div>
        <Description class="max-w-2xl text-lg opacity-80 leading-relaxed">
          {features.cta.description}
        </Description>
        <div class="mt-4 flex flex-wrap items-center justify-center gap-4">
          <Button
            href={features.cta.buttonLink}
            isPrimary
            class="px-8 py-3 text-base shadow-xl"
          >
            {features.cta.buttonText}
          </Button>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  @reference '../../styles/global.css';

  html {
    scroll-behavior: smooth;
  }
</style>
