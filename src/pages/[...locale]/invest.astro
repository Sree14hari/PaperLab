---
import Button from '~/components/Button.astro'
import Description from '~/components/Description.astro'
import ArrowRightIcon from '~/icons/ArrowRightIcon.astro'
import Layout from '~/layouts/Layout.astro'
import { getLocale, getUI } from '~/utils/i18n'
export { getStaticPaths } from '~/utils/i18n'

const locale = getLocale(Astro)
const {
  routes: { invest },
  layout,
} = getUI(locale)
---

<Layout title={layout.invest.title} description={layout.invest.description}>
  <main class="container flex min-h-screen w-full flex-col gap-24 py-24">
    <!-- Hero Section -->
    <div class="flex w-full flex-col gap-6 lg:w-3/4">
      <Description class="text-6xl leading-none font-bold lg:text-7xl">
        {invest.title}
      </Description>
      <Description class="max-w-4xl text-lg opacity-80 leading-relaxed">
        {invest.description}
      </Description>
    </div>

    <!-- Contact Cards (Email & Discord) -->
    <div class="grid grid-cols-1 gap-8 md:grid-cols-2">
      <!-- Email Card -->
      <div class="border-subtle bg-subtle/50 hover:border-coral group flex flex-col justify-between gap-6 rounded-2xl border p-8 transition-all duration-200">
        <div class="flex flex-col gap-4">
          <div class="bg-coral/10 text-coral flex size-12 items-center justify-center rounded-xl border border-coral/20">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-6 text-coral"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              />
            </svg>
          </div>
          <div class="text-2xl font-bold">{invest.email.title}</div>
          <p class="text-base opacity-75 leading-relaxed">
            {invest.email.description}
          </p>
          <div class="text-sm font-mono text-coral font-semibold">
            {invest.email.address}
          </div>
        </div>

        <Button
          href={invest.email.link}
          isPrimary
          class="w-fit"
        >
          {invest.email.button}
          <ArrowRightIcon class="size-4" />
        </Button>
      </div>

      <!-- Discord Card -->
      <div class="border-subtle bg-subtle/50 hover:border-coral group flex flex-col justify-between gap-6 rounded-2xl border p-8 transition-all duration-200">
        <div class="flex flex-col gap-4">
          <div class="bg-coral/10 text-coral flex size-12 items-center justify-center rounded-xl border border-coral/20">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="size-6 text-coral fill-current"
              viewBox="0 0 127.14 96.36"
            >
              <path
                d="M107.7,8.07A105.15,105.15,0,0,0,81.47,0a72.06,72.06,0,0,0-3.36,6.83A97.68,97.68,0,0,0,49,6.83,72.37,72.37,0,0,0,45.64,0,105.89,105.89,0,0,0,19.39,8.09C2.79,32.65-1.71,56.6.54,80.21h0A105.73,105.73,0,0,0,32.71,96.36,77.7,77.7,0,0,0,39.6,85.25a68.42,68.42,0,0,1-10.85-5.18c.91-.66,1.8-1.34,2.66-2a75.57,75.57,0,0,0,64.32,0c.87.71,1.76,1.39,2.66,2a68.68,68.68,0,0,1-10.87,5.19,77,77,0,0,0,6.89,11.1A105.25,105.25,0,0,0,126.6,80.22h0C129.24,52.84,122.09,29.11,107.7,8.07ZM42.45,65.69C36.18,65.69,31,60,31,53s5-12.74,11.43-12.74S54,45.91,53.89,53,48.84,65.69,42.45,65.69Zm42.24,0C78.41,65.69,73.25,60,73.25,53s5-12.74,11.44-12.74S96.23,45.91,96.12,53,91.08,65.69,84.69,65.69Z"
              />
            </svg>
          </div>
          <div class="text-2xl font-bold">{invest.discord.title}</div>
          <p class="text-base opacity-75 leading-relaxed">
            {invest.discord.description}
          </p>
          <div class="text-sm font-semibold text-coral">
            discord.gg/gnjkkGT5RS
          </div>
        </div>

        <Button
          href={invest.discord.link}
          isPrimary
          class="w-fit"
        >
          {invest.discord.button}
          <ArrowRightIcon class="size-4" />
        </Button>
      </div>
    </div>

    <!-- Highlights Section -->
    <div class="flex w-full flex-col gap-6">
      <div class="text-3xl font-bold lg:text-4xl">
        {invest.highlights.title}
      </div>
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <div class="border-subtle bg-subtle/50 flex flex-col gap-3 rounded-2xl border p-6">
          <div class="text-xl font-bold">{invest.highlights.market.title}</div>
          <p class="text-sm opacity-75 leading-relaxed">
            {invest.highlights.market.description}
          </p>
        </div>
        <div class="border-subtle bg-subtle/50 flex flex-col gap-3 rounded-2xl border p-6">
          <div class="text-xl font-bold">{invest.highlights.privacy.title}</div>
          <p class="text-sm opacity-75 leading-relaxed">
            {invest.highlights.privacy.description}
          </p>
        </div>
        <div class="border-subtle bg-subtle/50 flex flex-col gap-3 rounded-2xl border p-6">
          <div class="text-xl font-bold">{invest.highlights.innovation.title}</div>
          <p class="text-sm opacity-75 leading-relaxed">
            {invest.highlights.innovation.description}
          </p>
        </div>
      </div>
    </div>
  </main>
</Layout>
