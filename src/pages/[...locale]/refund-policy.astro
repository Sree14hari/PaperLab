---
import Title from '~/components/Title.astro'
import Layout from '~/layouts/Layout.astro'
import { getLocale, getUI } from '~/utils/i18n'
export { getStaticPaths } from '~/utils/i18n'

const locale = getLocale(Astro)

const {
  routes: { refundPolicy },
  layout,
} = getUI(locale)
---

<Layout title={layout.refundPolicy.title} description={layout.refundPolicy.description}>
  <main class="mx-auto mt-52 w-1/2 pb-24">
    <Title id="refund-policy" class="xl:text-6xl xl:leading-none">{refundPolicy.title}</Title>
    <div class="ml-4 font-bold">{refundPolicy.lastUpdated}</div>

    <Title class="mt-16 text-4xl font-bold" id="introduction">
      {refundPolicy.sections.introduction.title}
    </Title>
    <p>{refundPolicy.sections.introduction.body}</p>

    <Title class="mt-16 text-4xl font-bold" id="1-cancellation">
      {refundPolicy.sections.cancellation.title}
    </Title>
    <p>{refundPolicy.sections.cancellation.body}</p>

    <Title class="mt-16 text-4xl font-bold" id="2-refund-eligibility">
      {refundPolicy.sections.refunds.title}
    </Title>
    <p>{refundPolicy.sections.refunds.body}</p>

    <Title class="mt-16 text-4xl font-bold" id="3-refund-timeline">
      {refundPolicy.sections.timeline.title}
    </Title>
    <p>{refundPolicy.sections.timeline.body}</p>

    <Title class="mt-16 text-4xl font-bold" id="4-how-to-request">
      {refundPolicy.sections.request.title}
    </Title>
    <p>{refundPolicy.sections.request.body}</p>

    {
      refundPolicy.sections.contact && (
        <>
          <Title class="mt-16 text-4xl font-bold" id="5-merchant-contact">
            {refundPolicy.sections.contact.title}
          </Title>
          <p>{refundPolicy.sections.contact.body}</p>
          <div class="mt-6 flex flex-col gap-3 rounded-xl border border-white/10 bg-white/5 p-6 backdrop-blur-sm">
            <div>
              <span class="font-semibold text-white/90">Legal Name / Proprietor:</span>
              <span class="ml-2 opacity-80">{refundPolicy.sections.contact.legalName}</span>
            </div>
            <div>
              <span class="font-semibold text-white/90">Email:</span>
              <a
                href={`mailto:${refundPolicy.sections.contact.email}`}
                class="paper-link ml-2 font-medium"
              >
                {refundPolicy.sections.contact.email}
              </a>
            </div>
            <div>
              <span class="font-semibold text-white/90">Phone / WhatsApp:</span>
              <a
                href={`tel:${refundPolicy.sections.contact.phone}`}
                class="paper-link ml-2 font-medium"
              >
                {refundPolicy.sections.contact.phone}
              </a>
            </div>
            <div>
              <span class="font-semibold text-white/90">Registered Address:</span>
              <span class="ml-2 opacity-80">{refundPolicy.sections.contact.address}</span>
            </div>
          </div>
        </>
      )
    }
  </main>
</Layout>
<style>
  @reference '../../styles/global.css';

  p {
    @apply mt-4 opacity-55;
  }
</style>
