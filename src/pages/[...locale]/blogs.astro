---
import Layout from '~/layouts/Layout.astro'
import { getLocale, getPath, getUI } from '~/utils/i18n'
import { getAllBlogPosts } from '~/utils/blog'
import Button from '~/components/Button.astro'
import CheckIcon from '~/icons/CheckIcon.astro'
export { getStaticPaths } from '~/utils/i18n'

const locale = getLocale(Astro)
const getLocalePath = getPath(locale)
const { layout } = getUI(locale)

const posts = getAllBlogPosts()
const post = posts[0]

const msStoreLink =
  'https://apps.microsoft.com/detail/9P0XRRPBC34P?hl=en-us&gl=IN&ocid=pdpshare'
---

<Layout
  title={post ? `${post.title} - Paper Lab Blog` : (layout.blogs?.title ?? 'Blog - Paper Lab')}
  description={post?.subtitle ?? (layout.blogs?.description ?? 'Explore updates, deep dives, and insights on modern academic writing and Paper Lab.')}
  ogImage="https://paperlab.r3actr.work/previewpplab.png"
>
  <!-- Reading Progress Bar -->
  <div
    id="reading-progress-bar"
    class="fixed top-0 left-0 z-50 h-1 w-0 bg-coral transition-[width] duration-150 ease-out"
    aria-hidden="true"
  >
  </div>

  <main class="container mx-auto min-h-screen px-4 pt-12 pb-24 sm:px-6 lg:px-8">
    <!-- Breadcrumb & Top Bar -->
    <nav class="mb-8 flex items-center gap-2 text-xs text-dark/70 sm:text-sm" aria-label="Breadcrumb">
      <a href={getLocalePath('/')} class="hover:text-coral transition-colors">Home</a>
      <span>/</span>
      <span class="text-coral font-medium">Blog</span>
      {post && (
        <>
          <span class="hidden sm:inline">/</span>
          <span class="hidden max-w-md truncate sm:inline text-dark/80">
            {post.title}
          </span>
        </>
      )}
    </nav>

    {post && (
      <article class="mx-auto max-w-7xl">
        <!-- Article Hero Header -->
        <header class="mb-12 flex flex-col gap-6 border-b border-dark/10 pb-12">
          <!-- Tags & Category Badges -->
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full bg-coral px-3.5 py-1 text-xs font-bold text-white shadow-xs">
              Featured Deep Dive
            </span>
            {post.tags.slice(0, 3).map(tag => (
              <span class="rounded-full bg-coral/10 px-3 py-1 text-xs font-semibold text-coral">
                {tag}
              </span>
            ))}
          </div>

          <!-- Main Title (H1) -->
          <h1 class="font-junicode text-dark text-4xl leading-[1.08] font-bold tracking-tight sm:text-5xl lg:text-6xl">
            {post.title}
          </h1>

          <!-- Subtitle / Tagline -->
          <p class="max-w-4xl text-lg leading-relaxed text-dark/80 sm:text-xl">
            {post.subtitle}
          </p>

          <!-- Byline & Social Actions Bar -->
          <div class="mt-4 flex flex-wrap items-center justify-between gap-6 pt-4">
            <!-- Author info -->
            <div class="flex items-center gap-3.5">
              <div class="size-12 overflow-hidden rounded-full border border-coral/30 bg-coral/10 p-1.5 shadow-xs">
                <img
                  src={post.author.avatar}
                  alt={post.author.name}
                  class="size-full object-contain"
                />
              </div>
              <div class="flex flex-col">
                <span class="text-dark font-bold sm:text-base">
                  {post.author.name}
                </span>
                <div class="flex items-center gap-2 text-xs text-dark/60 sm:text-sm">
                  <time datetime={post.isoDate}>{post.date}</time>
                  <span>•</span>
                  <span>{post.readingTime}</span>
                </div>
              </div>
            </div>

            <!-- Share and Copy Actions -->
            <div class="flex items-center gap-2">
              <button
                type="button"
                id="copy-link-btn"
                class="flex cursor-pointer items-center gap-2 rounded-xl border border-dark/15 bg-subtle/50 px-3.5 py-2 text-xs font-semibold text-dark shadow-xs transition-all duration-200 hover:border-coral hover:text-coral"
                aria-label="Copy article link"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span id="copy-btn-text">Copy link</span>
              </button>

              <a
                href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent('https://paperlab.r3actr.work/blogs')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center rounded-xl border border-dark/15 bg-subtle/50 p-2 text-dark shadow-xs transition-all duration-200 hover:border-coral hover:text-coral"
                aria-label="Share on X"
              >
                <svg class="size-4 fill-current" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>

              <a
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent('https://paperlab.r3actr.work/blogs')}`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center rounded-xl border border-dark/15 bg-subtle/50 p-2 text-dark shadow-xs transition-all duration-200 hover:border-coral hover:text-coral"
                aria-label="Share on LinkedIn"
              >
                <svg class="size-4 fill-current" viewBox="0 0 24 24">
                  <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.64a1.66 1.66 0 0 0-1.66 1.66 1.66 1.66 0 0 0 1.66 1.66 1.66 1.66 0 0 0 1.66-1.66c0-.92-.74-1.66-1.66-1.66Z"/>
                </svg>
              </a>
            </div>
          </div>
        </header>

        <!-- Executive Summary / Key Takeaways Box -->
        <div class="mb-14 rounded-3xl border border-coral/30 bg-coral/10 p-6 sm:p-8">
          <div class="flex items-center gap-3">
            <span class="flex size-7 items-center justify-center rounded-full bg-coral text-white">
              <CheckIcon class="size-4" />
            </span>
            <h2 class="text-dark text-lg font-bold sm:text-xl">
              Key Takeaways from this Deep Dive
            </h2>
          </div>
          <div class="mt-4 grid grid-cols-1 gap-3.5 text-sm sm:grid-cols-2 sm:text-base">
            <div class="flex items-start gap-2.5 text-dark/85">
              <span class="text-coral font-bold">•</span>
              <span><strong>Dual-Mode Editing:</strong> Write fluidly in WYSIWYG without code, or switch instantly to Monaco LaTeX for math and formatting precision.</span>
            </div>
            <div class="flex items-start gap-2.5 text-dark/85">
              <span class="text-coral font-bold">•</span>
              <span><strong>Live A4 Previews:</strong> Catch ruined page breaks and spilling figures as you write, avoiding 2:00 AM compile-and-pray panic.</span>
            </div>
            <div class="flex items-start gap-2.5 text-dark/85">
              <span class="text-coral font-bold">•</span>
              <span><strong>Unified Workflow:</strong> Drag-and-drop section tree, built-in vector diagramming, and automated BibTeX citation library.</span>
            </div>
            <div class="flex items-start gap-2.5 text-dark/85">
              <span class="text-coral font-bold">•</span>
              <span><strong>Local-First & Private:</strong> Zero telemetry, no cloud lock-in, and full export to raw LaTeX archive anytime.</span>
            </div>
          </div>
        </div>

        <!-- 2-Column Content Layout (Article Body + Sticky Table of Contents) -->
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-[1fr_320px] lg:gap-16">
          <!-- Main Article Body -->
          <div class="min-w-0">
            <div
              class="blog-content prose max-w-none text-dark"
              set:html={post.contentHtml}
            />


          </div>

          <!-- Sticky Sidebar: Table of Contents & Quick Widget -->
          <aside class="hidden lg:block">
            <div class="sticky top-24 flex flex-col gap-6">
              <!-- Table of Contents Container -->
              <div class="rounded-3xl border border-dark/10 bg-subtle/50 p-6 shadow-sm">
                <h4 class="text-xs font-bold tracking-wider uppercase text-coral">
                  Table of Contents
                </h4>
                <nav class="mt-4 flex flex-col gap-1 text-sm" aria-label="Table of contents">
                  {post.headings.map(h => (
                    <a
                      href={`#${h.id}`}
                      class:list={[
                        'toc-link block rounded-lg px-2.5 py-1.5 text-dark/70 transition-all duration-200 hover:bg-coral/15 hover:text-coral',
                        h.depth === 3 ? 'pl-5 text-xs' : 'font-medium',
                      ]}
                      data-target={h.id}
                    >
                      {h.text}
                    </a>
                  ))}
                </nav>
              </div>

              <!-- Quick Mini CTA -->
              <div class="rounded-3xl border border-coral/30 bg-coral/10 p-6 text-center shadow-xs">
                <h4 class="text-dark text-base font-bold">
                  Try Paper Lab Beta
                </h4>
                <p class="mt-1.5 text-xs text-dark/70 leading-relaxed">
                  Built-in LaTeX engine, WYSIWYG diagrams, and instant A4 preview.
                </p>
                <Button href={msStoreLink} isPrimary class="mt-4 w-full !py-2 !text-xs font-bold">
                  Get it from Microsoft Store
                </Button>
              </div>
            </div>
          </aside>
        </div>
      </article>
    )}
  </main>
</Layout>

<script is:inline>
  // Dynamic Reading Progress Bar
  const progressBar = document.getElementById('reading-progress-bar');
  function updateProgress() {
    if (!progressBar) return;
    const totalHeight = document.documentElement.scrollHeight - window.innerHeight;
    if (totalHeight <= 0) return;
    const progress = Math.min(100, Math.max(0, (window.scrollY / totalHeight) * 100));
    progressBar.style.width = progress + '%';
  }
  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress, { passive: true });

  // Copy Link Button handler
  const copyBtn = document.getElementById('copy-link-btn');
  const copyBtnText = document.getElementById('copy-btn-text');
  if (copyBtn && copyBtnText) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        const original = copyBtnText.textContent;
        copyBtnText.textContent = 'Copied!';
        copyBtn.classList.add('border-coral', 'text-coral');
        setTimeout(() => {
          copyBtnText.textContent = original;
          copyBtn.classList.remove('border-coral', 'text-coral');
        }, 2000);
      } catch (err) {
        // Fallback if clipboard API fails
      }
    });
  }

  // Active TOC Scrollspy Highlight
  const tocLinks = document.querySelectorAll('.toc-link');
  const headingElements = Array.from(document.querySelectorAll('.blog-heading-2, .blog-heading-3'));

  if (headingElements.length > 0 && tocLinks.length > 0) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const id = entry.target.getAttribute('id');
            tocLinks.forEach((link) => {
              if (link.getAttribute('data-target') === id) {
                link.classList.add('bg-coral/20', '!text-coral', 'font-bold', 'translate-x-1');
              } else {
                link.classList.remove('bg-coral/20', '!text-coral', 'font-bold', 'translate-x-1');
              }
            });
          }
        });
      },
      {
        rootMargin: '0px 0px -60% 0px',
        threshold: 0,
      }
    );

    headingElements.forEach((el) => observer.observe(el));
  }
</script>
